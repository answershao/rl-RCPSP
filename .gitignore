# ---------- Python caches and build artifacts ----------
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
*.so

# ---------- Virtual environments and local configuration ----------
.venv/
venv/
env/
.env
.env.*
.pyenv/

# ---------- macOS / editor metadata ----------
.DS_Store
__MACOSX/
.idea/
*.swp
*~
# .vscode/ is intentionally tracked (launch.json defines the 9 RCPSP tasks);
# keep only personal bits out:
.vscode/*.code-workspace

# ---------- WorkBuddy workspace data (local memory / logs, not VCS material) ----------
.workbuddy/

# ---------- Datasets (4430 corpus + BKS xlsx; regenerate/provide externally) ----------
# Root-anchored: a bare "data/" would also match the SOURCE package src/data/
# (parsers.py / adapter.py / instances.py) and silently exclude it from VCS.
/data/

# ---------- Generated experiment outputs (all re-runnable via scripts + README) ----------
outputs/
# Note: root-level protocol artifacts below ARE committed on purpose:
#   splits.json   -- the single split manifest (seed 20260909, regen via scripts/make_splits.py)
#   scripts/*.csv outputs are only produced under outputs/ and stay ignored.

# ---------- Background training / run logs ----------
/logs/
*.log

# ---------- Test and tooling caches ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.coverage.*

{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MPLIB2: Summarize dataset",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/summarize_mplib2.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "data/MPLIB2"
            ]
        },
        {
            "name": "MPLIB2: Filter 10 projects x 50 activities x 5 resources",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/filter_mplib2.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "data/MPLIB2",
                "--projects",
                "10",
                "--activities-per-project",
                "50",
                "--resources",
                "5",
                "--output-dir",
                "data/MPLIB2_train_10_50_5",
                "--link"
            ]
        },
        {
            "name": "RCMPSP: Visualize one instance",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/visualize_instance.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "data/MPLIB2_train_10_50_5/MPLIB2_Set1_224.rcmp"
            ]
        },
        {
            "name": "RCMPSP: Solve all MPLIB2 10 projects x 50 activities x 5 resources",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.baselines",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "subProcess": false,
            "env": {
                "OMP_NUM_THREADS": "1",
                "MKL_NUM_THREADS": "1",
                "OPENBLAS_NUM_THREADS": "1",
                "NUMEXPR_NUM_THREADS": "1",
                "PYTHONUNBUFFERED": "1"
            },
            "args": [
                "--instances-root",
                "data/MPLIB2_train_10_50_5",
                "--seed",
                "17",
                "--exact-time-limit",
                "120",
                "--exact-workers",
                "1",
                "--instance-workers",
                "48",
                "--output-csv",
                "outputs/baselines/runs/mplib2_10_50_5/makespan_summary.csv"
            ]
        },
        {
            "name": "RCMPSP: Debug PPO-GIN environment step (CPU)",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.train_ppo",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "OMP_NUM_THREADS": "1",
                "MKL_NUM_THREADS": "1",
                "OPENBLAS_NUM_THREADS": "1",
                "NUMEXPR_NUM_THREADS": "1",
                "KMP_BLOCKTIME": "0",
                "MALLOC_ARENA_MAX": "4",
                "PYTHONUNBUFFERED": "1"
            },
            "args": [
                "--instances-root",
                "data/MPLIB2_train_10_50_5",
                "--n-envs",
                "1",
                "--total-timesteps",
                "512",
                "--n-steps",
                "512",
                "--batch-size",
                "64",
                "--n-epochs",
                "1",
                "--overfit-instances",
                "1",
                "--validation-interval",
                "1",
                "--eval-max-instances",
                "1",
                "--eval-batch-size",
                "1",
                "--gin-layers",
                "2",
                "--device",
                "cpu",
                "--mixed-precision",
                "none",
                "--vec-env",
                "subproc",
                "--torch-threads",
                "1",
                "--torch-interop-threads",
                "1",
                "--seed",
                "17",
                "--splits",
                "outputs/manifests/ppo_step_debug/splits.json",
                "--baseline-results",
                "outputs/baselines_mplib2_10_50_5/makespan_summary.csv",
                "--output-dir",
                "outputs/experiments/ppo/step_debug"
            ]
        },
        {
            "name": "RCMPSP: Train PPO-GIN on MPLIB2 10 projects x 50 activities x 5 resources (A800)",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.train_ppo",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "OMP_NUM_THREADS": "1",
                "MKL_NUM_THREADS": "1",
                "OPENBLAS_NUM_THREADS": "1",
                "NUMEXPR_NUM_THREADS": "1",
                "CUDA_MODULE_LOADING": "LAZY",
                "PYTHONUNBUFFERED": "1"
            },
            "args": [
                "--instances-root",
                "data/MPLIB2_train_10_50_5",
                "--n-envs",
                "96",
                "--total-timesteps",
                "6400000",
                "--batch-size",
                "8192",
                "--n-steps",
                "256",
                "--n-epochs",
                "2",
                "--gin-layers",
                "2",
                "--device",
                "cuda:0",
                "--mixed-precision",
                "bf16",
                "--cuda-matmul-precision",
                "high",
                "--torch-compile",
                "--compile-mode",
                "reduce-overhead",
                "--vec-env",
                "subproc",
                "--start-method",
                "spawn",
                "--torch-threads",
                "1",
                "--torch-interop-threads",
                "1",
                "--seed",
                "17",
                "--splits",
                "outputs/manifests/ppo_a800_vscode/splits.json",
                "--baseline-results",
                "outputs/baselines_mplib2_10_50_5/makespan_summary.csv",
                "--output-dir",
                "outputs/experiments/ppo/a800_runs/vscode_a800"
            ]
        },
        {
            "name": "RCMPSP: Evaluate PPO-GIN on all MPLIB2 10 projects x 50 activities x 5 resources (CPU)",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.train_ppo",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "OMP_NUM_THREADS": "1",
                "MKL_NUM_THREADS": "1",
                "OPENBLAS_NUM_THREADS": "1",
                "NUMEXPR_NUM_THREADS": "1",
                "KMP_BLOCKTIME": "0",
                "MALLOC_ARENA_MAX": "4",
                "PYTHONUNBUFFERED": "1"
            },
            "args": [
                "--instances-root",
                "data/MPLIB2_train_10_50_5",
                "--evaluate-only",
                "--device",
                "cpu",
                "--torch-threads",
                "20",
                "--torch-interop-threads",
                "1",
                "--eval-batch-size",
                "32",
                "--seed",
                "17",
                "--baseline-results",
                "outputs/baselines_mplib2_10_50_5/makespan_summary.csv",
                "--splits",
                "outputs/manifests/cpu_baseline/splits.json",
                "--output-dir",
                "outputs/experiments/ppo/cpu_baseline"
            ]
        },
    ]
}

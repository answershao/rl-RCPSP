{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RCPSP: Visualize one instance (test j30)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/visualize_instance.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "data/psplib/j30/j3010_1.sm"
            ]
        },
        {
            "name": "RCPSP: Baselines priority rules (train pool full)",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.baselines",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "OMP_NUM_THREADS": "1",
                "MKL_NUM_THREADS": "1",
                "OPENBLAS_NUM_THREADS": "1",
                "NUMEXPR_NUM_THREADS": "1",
                "PYTHONUNBUFFERED": "1"
            },
            "args": [
                "--data-root",
                "data",
                "--suites",
                "psp_grid",
                "--seed",
                "17",
                "--instance-workers",
                "8",
                "--output-csv",
                "outputs/rules_psp_grid/makespan_summary.csv"
            ]
        },
        {
            "name": "RCPSP: Baselines priority rules (test j30 smoke)",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.baselines",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "OMP_NUM_THREADS": "1",
                "MKL_NUM_THREADS": "1",
                "OPENBLAS_NUM_THREADS": "1",
                "NUMEXPR_NUM_THREADS": "1",
                "PYTHONUNBUFFERED": "1"
            },
            "args": [
                "--data-root",
                "data",
                "--suites",
                "psplib_j30",
                "--max-instances",
                "5",
                "--instance-workers",
                "4",
                "--seed",
                "17",
                "--output-csv",
                "outputs/rules_j30_smoke/makespan_summary.csv"
            ]
        },
        {
            "name": "RCPSP: GA smoke (test j30, 5 instances)",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.run_ga",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "OMP_NUM_THREADS": "1",
                "MKL_NUM_THREADS": "1",
                "OPENBLAS_NUM_THREADS": "1",
                "NUMEXPR_NUM_THREADS": "1",

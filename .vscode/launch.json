                "--population",
                "24",
                "--generations",
                "40",
                "--output-csv",
                "outputs/ga_smoke/ga.csv"
            ]
        },
        {
            "name": "RCPSP: GPHH smoke (train 8 + test j30 2)",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.run_gphh",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "OMP_NUM_THREADS": "1",
                "MKL_NUM_THREADS": "1",
                "OPENBLAS_NUM_THREADS": "1",
                "NUMEXPR_NUM_THREADS": "1",
                "PYTHONUNBUFFERED": "1"
            },
            "args": [
                "--data-root",
                "data",
                "--splits",
                "splits.json",
                "--train-instances",
                "8",
                "--seed",
                "17",
                "--population",
                "30",
                "--generations",
                "15",
                "--eval-suites",
